generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String?
  googleId     String?        @unique
  role          Role           @default(STUDENT)
  avatarUrl    String?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  notifyMessages         Boolean @default(true)
  notifyConnections      Boolean @default(true)
  notifyVideoSessions    Boolean @default(true)
  isSuspended      Boolean   @default(false)
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  passwordResetTokens PasswordResetToken[]
  profile       Profile?
  notes         Note[]
  createdSessions      Session[]            @relation("CreatedSessions")
  sessionParticipants  SessionParticipant[]
  messages             Message[]
  savedSessions        SavedSession[]
  sentConnections      Connection[]         @relation("SentConnections")
  receivedConnections  Connection[]         @relation("ReceivedConnections")
  sentNotifications    Notification[]       @relation("SentNotifications")
  receivedNotifications Notification[]      @relation("ReceivedNotifications")
  submittedReports     Report[]             @relation("SubmittedReports")
  reportsReceived      Report[]             @relation("ReportsReceived")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("android")
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  codeHash       String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  resetTokenHash String?   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
}

model Skill {
  id            String         @id @default(cuid())
  name          String         @unique
  category      String
  createdAt     DateTime       @default(now())
  profileSkills ProfileSkill[]
  sessionTags   SessionTag[]
}

model StudyArea {
  id                 String              @id @default(cuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  profileStudyAreas  ProfileStudyArea[]
}

model Profile {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  learningGoal String?
  teachGoal    String?
  interests    String[]            @default([])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  skills       ProfileSkill[]
  studyAreas   ProfileStudyArea[]
}

model ProfileSkill {
  id        String   @id @default(cuid())
  profileId String
  skillId   String
  level     Level
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@unique([profileId, skillId])
}

model ProfileStudyArea {
  id          String    @id @default(cuid())
  profileId   String
  studyAreaId String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studyArea   StudyArea @relation(fields: [studyAreaId], references: [id])

  @@unique([profileId, studyAreaId])
}

model Note {
  id        String      @id @default(cuid())
  title     String
  content   String
  summary   String?     
  tags      String[]
  isPublic  Boolean     @default(false)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  photos    NotePhoto[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model NotePhoto {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model Session {
  id          String        @id @default(cuid())
  title       String
  type        SessionType   @default(TEXT)
  status      SessionStatus @default(ACTIVE)
  summary     String?
  transcript  String? 
  scheduledAt DateTime?     
  joinCode    String        @unique @default(cuid())
  encryptedPassword String?
  isPublic    Boolean       @default(false)
  createdBy   String
  creator     User          @relation("CreatedSessions", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    Message[]
  participants SessionParticipant[]
  tags        SessionTag[]
  savedBy     SavedSession[]
  notifications Notification[]
  reports     Report[]
}

model SessionTag {
  id        String  @id @default(cuid())
  sessionId String
  skillId   String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@unique([sessionId, skillId])
}

model SavedSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model SessionParticipant {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  sessionId String
  senderId  String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id            String           @id @default(cuid())
  requesterId   String
  requester     User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId   String
  addressee     User             @relation("ReceivedConnections", fields: [addresseeId], references: [id], onDelete: Cascade)
  status        ConnectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  notifications Notification[]

  @@unique([requesterId, addresseeId])
}

model Notification {
  id           String           @id @default(cuid())
  recipientId  String
  recipient    User             @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User             @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  type         NotificationType
  connectionId String?
  connection   Connection?      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
}

model Report {
  id             String       @id @default(cuid())
  targetType     ReportTargetType
  reporterId     String
  reporter       User         @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         ReportReason
  details        String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  @@index([sessionId])
  @@index([reportedUserId])
}

enum ReportTargetType {
  SESSION
  USER
}

enum ReportReason {
  SPAM_OR_ADVERTISING
  HARASSMENT_OR_BULLYING
  HATE_SPEECH_OR_DISCRIMINATION
  INAPPROPRIATE_CONTENT
  ACADEMIC_DISHONESTY
  IMPERSONATION_OR_FAKE_PROFILE
  SCAM_OR_PHISHING
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  SESSION_INVITE
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum SessionType {
  TEXT
  VIDEO
}